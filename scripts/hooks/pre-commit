#!/bin/sh
# Iroca pre-commit フック（git 追跡される正はこのファイル）。
#
# 有効化（clone 直後に 1 回、リポジトリルートで実行）:
#   git config core.hooksPath scripts/hooks
#
# 内容: 範囲のファイル（tools/review_state.py の in_main_scope: ハーネスがコンパイルする製品ソース・
# scripts/headless-run・tools の測定器。範囲は Harness.csproj の Compile Include から導出。UI/Infra 等は対象外で、
# ci.yml の型チェックが受け持つ）がステージされているとき、tools/check_visual_review.py が次の順で検査する。
#   1. 視覚レビューの承認が有効なこと（固定設定とワンショット/追加操作後の両方が、同じ比較の実行と同じ中身を指す。
#      tools/workflow_review.py の validate_approval）
#   2. ステージしたファイルごとに、コミットされる中身（index。git commit -- <パス> の一時 index も）が
#      「HEAD と同じ」か「承認した比較で測った中身と同じ」こと（ファイル単位。時刻は見ない。2026-11-10〜）
#   3. dev_safe の測定器と基準が、承認した比較のときと同じ中身なこと
#   4. 出力品質ゲートのしきい値較正 (quality_report.py --validate) が健全なこと
#      （保存済みの CSV を読むだけで、今のコードの出力は測らない）
# 回避: SKIP_VISUAL_REVIEW=1（出力に影響しない変更＝IO/プレビュー/コメントのみに限る）

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

# venv の python を優先する。Windows と POSIX でレイアウトが違うので両方見る
# （以前は Windows 決め打ちで、POSIX では素の python へ落ちていた）。
PY="$ROOT/.venv/Scripts/python.exe"
[ -x "$PY" ] || PY="$ROOT/.venv/bin/python"
[ -x "$PY" ] || PY=python

exec "$PY" "$ROOT/tools/check_visual_review.py"
