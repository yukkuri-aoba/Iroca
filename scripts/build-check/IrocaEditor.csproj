<!--
  Unity を起動せずに本体の asmdef（UI・Automation。下の Core・Services・Runtime は ProjectReference）を
  dotnet で型チェック・ビルドするための最小プロジェクト。Unity の asmdef と同じ境目で分けてあるので、下の層が上の層を使うと落ちる。CI からも `dotnet build scripts/build-check/IrocaEditor.csproj`
  だけで構文・型エラーを検出できる。

  Unity DLL のパスはデフォルトで VRChat 標準の 2022.3.22f1 を見にいく。
  別バージョンを使う場合は MSBuild プロパティか環境変数で上書きする:

    dotnet build scripts/build-check/IrocaEditor.csproj -p:UnityVersion=2022.3.22f1
    dotnet build scripts/build-check/IrocaEditor.csproj -p:UnityEditorPath="C:\Program Files\Unity\Hub\Editor\2022.3.22f1\Editor\Data\Managed"
    # または
    $env:UNITY_EDITOR_PATH = "C:\Program Files\Unity\Hub\Editor\2022.3.22f1\Editor\Data\Managed"
    dotnet build scripts/build-check/IrocaEditor.csproj

  出力 DLL は scripts/build-check/bin/ に置かれる（gitignore 済）。
  Unity のアセンブリ生成とは別物なので、これをパッケージに含めないこと。
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>com.yukkuri-aoba.iroca.Editor</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <Import Project="IrocaAssembly.props" />

  <!-- Code/Debug・McpIntegration・SentisIntegration・NdmfIntegration は別の asmdef。Debug は IrocaEditor.Debug.csproj、
       残りは導入環境でのみコンパイルされるので IrocaMcpCheck・IrocaSentisCheck・IrocaNdmfCheck で型チェックする。 -->
  <ItemGroup>
    <Compile Include="..\..\Code\UI\**\*.cs" />
    <Compile Include="..\..\Code\Automation\**\*.cs" />
    <Compile Include="..\..\Code\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="IrocaEditor.Core.csproj" />
    <ProjectReference Include="IrocaEditor.Services.csproj" />
    <ProjectReference Include="IrocaEditor.Runtime.csproj" />
  </ItemGroup>

</Project>
