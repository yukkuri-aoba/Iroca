<!--
  Code/ の本体ロジック(PixelProcessor 等)を Unity を起動せず dotnet で実行するためのハーネス。
  実 Unity DLL(CoreModule)を参照するので、リファレンスアセンブリと違い実行時に動く。
  Code/ を同一アセンブリに取り込むので internal(MaskSnapshot/PixelProcessor)へアクセスできる。

    dotnet run (project scripts/headless-run/Harness.csproj) args: in.raw mask.raw out.raw

  raw 形式: [int32 w][int32 h][payload]  (RGBA=w*h*4 bytes / mask=w*h bytes 1=除外)
  出力 DLL は scripts/headless-run/bin/ (gitignore 済)。製品パッケージには含めない。
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <!-- Core の作業配列はネイティブメモリ(ポインタ)で扱う(0.3.0)。Editor asmdef の allowUnsafeCode と対。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>Iroca</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>0414;0649;CS0219;CS8632;CS0169;CS0618</NoWarn>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>IrocaHeadless</AssemblyName>
    <!-- DLL のバイト列を「ソース + コンパイラ」だけで決める(2026-09-14)。
         SourceLink は obj/Harness.sourcelink.json に git の HEAD コミット SHA を埋め込み、それが
         CoreCompile の入力なので、ドキュメントだけのコミットでも次のビルドで DLL が書き換わる。
         テストの実行キャッシュは DLL のダイジェストをキーに持つため、コミットごとに全エントリが
         無効化され(ウォーム 3 分 → コールド 7 分半)、コミットが多いほどテストが遅くなっていた。
         製品パッケージには入らないハーネス専用 DLL なので SourceLink を切る。 -->
    <EnableSourceLink>false</EnableSourceLink>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Deterministic>true</Deterministic>
    <!-- ビルドしたディレクトリにも DLL のバイト列を左右させない(2026-11-10)。PE には PDB の絶対パス(RSDS)が
         入り、PDB はソースの絶対パスを持つので、別のディレクトリ(worktree・一時ディレクトリへ書き出した
         index の中身)で同じソースをビルドすると DLL も実行キャッシュの鍵も変わっていた。リポジトリの
         ルートを固定の名前へ写す。同じ中身なら、どこでビルドしても同じ DLL になる。
         git の中かどうかでも変えない: SDK は git の中だと git に無いファイル(obj に生成した属性の .cs)を
         PDB に埋め込むので、git の外(一時ディレクトリ)でのビルドと DLL が違っていた(実測)。git には問い合わせない。 -->
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))=/_/</PathMap>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <!-- デバッグ情報(PDB)を作らない(2026-11-15、T8)。PDB は文書ごとのチェックサムを持ち、DLL はその PDB の id を
         持つので、コメント・空行・空白・改行の種類だけの違いでも DLL のバイト列が変わり、DLL を鍵にする実行キャッシュが
         全部外れていた。PDB が無ければ DLL は IL とメタデータだけで決まる(コンパイル結果が同じなら同じ DLL)。
         代わりに、ハーネスが落ちたときのスタックトレースに行番号が出ない(メソッド名は出る)。 -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup>
    <UnityVersion Condition="'$(UnityVersion)' == ''">2022.3.22f1</UnityVersion>
    <UnityManaged Condition="'$(UnityManaged)' == ''">C:\Program Files\Unity\Hub\Editor\$(UnityVersion)\Editor\Data\Managed</UnityManaged>
  </PropertyGroup>

  <!-- 取り込む製品ソース(Code/Core 全部と AI 提案の純計算層)の一覧は HarnessSources.props の 1 か所に置く
       (dev_safe の局所プローブも同じものを Import する。0.4.0 の計画の 3-13)。 -->
  <Import Project="HarnessSources.props" />

  <ItemGroup>
    <Compile Include="Harness.cs" />
    <!-- AI 提案の純計算(Code/MaskSuggest/Ops)の配列を受ける口。製品は呼ばないので、配布物に入れずここで partial として足す。 -->
    <Compile Include="SamOps.Arrays.cs" />
    <!-- AI 提案の推論(sam-propose のモード)。製品は Sentis で走らせるモデルを、ハーネスは onnxruntime(CPU)で走らせる。 -->
    <Compile Include="OrtSamInference.cs" />
    <Compile Include="SamPropose.cs" />
    <Compile Include="Harness.Oneshot.cs" />
  </ItemGroup>

  <!-- onnxruntime(MIT。ハーネスだけが使い、製品・配布物には入らない)。版は dev_safe の Python の onnxruntime と同じにそろえる
       (同じ入力で Python の写しと推論の結果を突き合わせるため。変えるときは両方を同時に)。
       managed の DLL だけを依存として取り込み、ネイティブの onnxruntime は出力の直下へ写す: 依存の一覧(deps.json)に
       runtimes/ の下のネイティブを載せると、出力の直下のファイルだけを写す所(tools/harness_build.py の snapshot)で
       ハーネスが起動しなくなるため。ネイティブはこの OS の分だけ(Windows・Linux の x64)。 -->
  <PropertyGroup>
    <OnnxRuntimeVersion>1.29.0</OnnxRuntimeVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="$(OnnxRuntimeVersion)" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="$(OnnxRuntimeVersion)" ExcludeAssets="all" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <None Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\win-x64\native\onnxruntime.dll" Link="onnxruntime.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <None Include="$(PkgMicrosoft_ML_OnnxRuntime)\runtimes\linux-x64\native\libonnxruntime.so" Link="libonnxruntime.so" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- 実装入りの実 DLL を直接参照(リファレンスアセンブリでなく)。Color32/Mathf/Color は CoreModule。 -->
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityManaged)\UnityEngine\UnityEngine.CoreModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- Unity DLL 不在を「Code/ のコンパイルエラー」と区別できる明示メッセージで fail させる。
       これが無いと参照解決エラーの羅列になり、テスト側の skip/fail 分離が濁る。 -->
  <Target Name="CheckUnityDlls" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(UnityManaged)\UnityEngine\UnityEngine.CoreModule.dll')"
           Text="Unity CoreModule DLL が見つかりません: $(UnityManaged)。UnityVersion / UnityManaged プロパティ(または環境変数)で上書きしてください。" />
  </Target>

</Project>
